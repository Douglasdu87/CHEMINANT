# Secrets SERVEUR uniquement (Edge Functions) : jamais dans le navigateur, jamais dans git.
# SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY sont injectées
# automatiquement dans les Edge Functions : inutile de les déclarer ici.
# En production : supabase secrets set --env-file .env
# En local      : supabase functions serve api --env-file .env

# Origine autorisée à appeler l'Edge Function « api » (CORS)
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Adresse du site, utilisée dans les liens envoyés par e-mail (invitations, mot de passe)
SITE_URL=http://localhost:5173

# Paiement : "simulation" enregistre le règlement sans prestataire pour un moyen de paiement
# sans clé (Mobile Money, pas encore branché). Avant l'ouverture au public : production
PAYMENT_MODE=simulation

# Stripe (carte) : clé secrète (sk_test_… pour les essais) et secret du webhook (whsec_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal : identifiants de l'application developer.paypal.com et identifiant du webhook
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# sandbox pour les essais, live en production
PAYPAL_ENV=sandbox
