# Secrets SERVEUR uniquement (Edge Functions) : jamais dans le navigateur, jamais dans git.
# SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY sont injectées
# automatiquement dans les Edge Functions : inutile de les déclarer ici.
# En production : supabase secrets set --env-file .env
# En local      : supabase functions serve api --env-file .env

# Origine autorisée à appeler l'Edge Function « api » (CORS)
ALLOWED_ORIGIN=http://localhost:5173

# Adresse du site, utilisée dans les liens envoyés par e-mail (invitations, mot de passe)
SITE_URL=http://localhost:5173

# Paiement : "simulation" enregistre le règlement sans prestataire (tests uniquement).
# À remplacer avant l'ouverture au public, une fois Stripe / PayPal / Mobile Money branchés.
PAYMENT_MODE=simulation
