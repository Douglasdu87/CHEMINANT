# Copier ce fichier en .env côté SERVEUR uniquement (jamais dans le navigateur, jamais dans git).
# Chaîne de connexion fournie par la console Neon (Dashboard → Connection details).
DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxxxxx.eu-central-1.aws.neon.tech/cheminant?sslmode=require

# Secret de signature des sessions (chaîne aléatoire d'au moins 32 caractères)
SESSION_SECRET=a-remplacer
